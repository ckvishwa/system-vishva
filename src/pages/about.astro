---
import Base from '../layouts/Base.astro';
import { parse } from 'yaml';
import profileRaw from '../content/profile.yaml?raw';
const profile = parse(profileRaw) as { name: string; facts: string[] };
---
<Base title="About">
  <section class="wrap prose pad-9">
    <h1 class="display" data-fx="decrypt">About</h1>
    <p class="mt-6">{profile.facts.join(' ')}</p>
    <p class="muted mt-4">TODO: two paragraphs in your own voice on how you think about AI systems, security and reliability.</p>
  </section>
</Base>
