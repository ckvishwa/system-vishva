---
// ARD §7 idea 7 — the site's own history as a telemetry feed (from scripts/build-manifest.ts).
import Base from '../layouts/Base.astro';
import build from '../generated/build.json';
---
<Base title="Logs">
  <section class="wrap pad-9">
    <h1 class="display" data-fx="decrypt">Logs</h1>
    {build.log.length === 0 && <p class="mono muted mt-6">No commit history is available in this build.</p>}
    <ol class="mono feed">
      {build.log.map((l) => <li><span class="muted">{l.date}</span> <span class="info">{l.hash}</span> {l.subject}</li>)}
    </ol>
  </section>
</Base>
<style>.feed { list-style: none; margin-top: var(--s-6); display: grid; gap: var(--s-2); font-size: var(--t-sm); } .feed li { border-top: 1px solid var(--c-grid); padding-top: var(--s-2); }</style>
