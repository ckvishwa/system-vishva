---
// The ONE WebGL canvas (ARD D-06). Phase 0: static SVG graph (= tier C, and first paint for all tiers).
// Phase 1: the script below lazy-loads engine/scene/SystemScene.ts after LCP for tiers A/B.
import { parse } from 'yaml';
import raw from '../content/systems-graph.yaml?raw';
const g = parse(raw) as { nodes: { id: string; label: string; x: number; y: number }[]; edges: [string, string][] };
const pos = Object.fromEntries(g.nodes.map((n) => [n.id, n]));
---
<div class="hero-scene" aria-hidden="true">
  <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="edges">
    {g.edges.map(([a, b]) => <line x1={pos[a].x} y1={pos[a].y} x2={pos[b].x} y2={pos[b].y} vector-effect="non-scaling-stroke" />)}
  </svg>
  {g.nodes.map((n) => (
    <span class="node mono" style={`left:${n.x}%;top:${n.y}%`} data-node={n.id}><i></i>{n.label}</span>
  ))}
  <canvas id="system-environment" hidden></canvas>
</div>
<script>
  import { currentTier } from '../engine/tier';
  // Phase 1: if (currentTier() !== 'C') requestIdleCallback(() => import('../engine/scene/SystemScene').then(...))
  document.documentElement.dataset.sceneTier = currentTier();
</script>
<style>
  .hero-scene { position: absolute; inset: 0; z-index: var(--z-scene); pointer-events: none; }
  .edges { position: absolute; inset: 8% 6%; width: 88%; height: 84%; }
  .edges line { stroke: var(--c-rule); stroke-width: 1; }
  .node { position: absolute; transform: translate(-50%, -50%); color: var(--c-muted); display: flex; align-items: center; gap: 8px; margin: 8% 6%; }
  .node i { width: 7px; height: 7px; background: var(--c-text); display: block; }
  .node[data-node='authorization'] i { background: var(--c-system); }
  .node[data-node='security'] i { background: var(--c-risk); }
  @media (max-width: 720px) { .node { font-size: 10px; } }
</style>
