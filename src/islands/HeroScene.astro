---
// The ONE WebGL canvas (ARD D-06). The static SVG is tier C and first paint for every tier;
// engine/scene/hero.ts lazy-loads SystemScene (and Three.js) after load for tiers A/B and
// cross-fades to the canvas once its first frame has rendered.
import { parse } from 'yaml';
import GridCoords from '../components/ui/GridCoords.astro';
import GlyphPortrait from '../components/ui/GlyphPortrait.astro';
import '../generated/graph.css'; // node positions, generated from systems-graph.yaml by scripts/build-manifest.ts
import raw from '../content/systems-graph.yaml?raw';
const g = parse(raw) as { nodes: { id: string; label: string; x: number; y: number }[]; edges: [string, string][] };
const pos = Object.fromEntries(g.nodes.map((n) => [n.id, n]));
const graph = JSON.stringify({ nodes: g.nodes, edges: g.edges });
---
<div class="hero-scene" data-graph={graph}>
  <div class="hero-grid grid-bg" data-depth="0.2" aria-hidden="true"></div>
  <GridCoords />
  <div class="plot" data-depth="0.5">
    <!-- Layer A (back): the same graph as /systems/, very low contrast, slow CSS drift (disabled
         automatically under reduced motion / tier C by the global motion.css override). Decorative. -->
    <svg class="edges" aria-hidden="true" viewBox="0 0 100 100" preserveAspectRatio="none">
      {g.edges.map(([a, b]) => <line x1={pos[a].x} y1={pos[a].y} x2={pos[b].x} y2={pos[b].y} vector-effect="non-scaling-stroke" />)}
    </svg>
    <!-- Layer B (middle): the glyph portrait. Real markup, see components/ui/GlyphPortrait.astro. -->
    <GlyphPortrait />
    <!-- Node labels stay on top so they read clearly over the portrait, and are real links: each one
         is "node activation" to the matching row on /systems/, not just a decorative dot. -->
    {g.nodes.map((n) => (
      <a class="node mono" data-node={n.id} data-sound="click" href={`/systems/#row-${n.id}`}><i></i><span class="lbl">{n.label}</span></a>
    ))}
  </div>
  <!-- HUD (ADR-0012 E6): real session time, pointer and route. Static text until the hero script updates it; hidden in tier C. -->
  <div class="hud mono" data-hud aria-hidden="true">
    <i class="br tl"></i><i class="br tr"></i><i class="br bl"></i><i class="br brr"></i>
    <span class="hud-prompt" data-hud-prompt>vishva@system:~$</span>
    <span class="hud-tc" data-hud-time>00:00:00:00</span>
    <span class="hud-xy" data-hud-xy></span>
  </div>
</div>
<button type="button" class="depth-chip hard mono" data-depth-chip hidden>Enable depth</button>
<script>
  import { currentTier } from '../engine/tier';
  import { mountHero } from '../engine/scene/hero';

  let unmount: (() => void) | null = null;
  const stop = () => { unmount?.(); unmount = null; };

  document.documentElement.dataset.sceneTier = currentTier();
  // ClientRouter: init on every page-load, release before every swap (ARD §5 cleanup rule).
  document.addEventListener('astro:page-load', () => {
    stop();
    const root = document.querySelector<HTMLElement>('.hero-scene');
    const tier = currentTier();
    if (root && tier !== 'C') unmount = mountHero(root, tier);
  });
  document.addEventListener('astro:before-swap', stop);
</script>
<style>
  .hero-scene { position: absolute; inset: 0; z-index: var(--z-scene); pointer-events: none; }
  /* One 48px cell of overscan on every side, so the grid origin is a multiple of 48 from the hero edge and the T4 coordinates sit on real lines. */
  .hero-grid { position: absolute; inset: -48px; }
  /* E1: the graph lives in the upper right; the lower left belongs to the text. */
  .plot { position: absolute; inset: 10% 6% 34% 44%; container-type: inline-size; } /* query container for GlyphPortrait's cqw sizing */
  /* Fixed height, not a bottom inset: a percentage bottom-inset drifts with hero-copy's own content
     height (it grew once the session card was added) and can start overlapping the hero text, which
     a dense glyph portrait makes far more noticeable than the original sparse dot graph ever was. */
  @media (max-width: 720px) { .plot { inset: 6% 6% auto 6%; height: 100px; } }
  .edges, :global(#system-environment) { position: absolute; inset: 0; width: 100%; height: 100%; }
  /* Layer A: very low contrast (meaning: dependency — this is the same structure /systems/ shows, just
     ambient here) and a slow drift. prefers-reduced-motion disables `animation` globally (motion.css);
     tier C can be reduced-motion-false but still weak hardware, so it gets its own explicit override below. */
  .edges line { stroke: var(--c-rule); stroke-width: 1; opacity: 0.45; }
  /* Animated on .edges itself, not .plot: .plot already carries the JS-driven parallax transform
     (data-depth), and a CSS animation on the same property would fight it every frame. */
  .edges { animation: drift 48s var(--e-inout) infinite alternate; }
  @keyframes drift { from { transform: translate(0, 0); } to { transform: translate(-1.5%, 1%); } }
  :global(html[data-tier='C']) .edges { animation: none; }
  :global(#system-environment) { opacity: 0; transition: opacity var(--d-3) var(--e-out); }
  .node { position: absolute; display: block; color: var(--c-muted); pointer-events: auto; }
  .node i { position: absolute; left: 0; top: 0; width: 7px; height: 7px; background: var(--c-text); transform: translate(-50%, -50%); }
  .node .lbl { position: absolute; left: 12px; top: 0; transform: translateY(-50%); white-space: nowrap; }
  .node[data-node='authorization'] i { background: var(--c-system); }
  .node[data-node='security'] i { background: var(--c-risk); }
  .node:hover, .node:focus-visible { color: var(--c-text); }
  .node:hover i, .node:focus-visible i { background: var(--c-info); }
  /* Cross-fade: the canvas draws edges and markers; labels stay HTML text. All absolute, so no layout shift. */
  .edges, .node i { transition: opacity var(--d-3) var(--e-out); }
  .is-live :global(#system-environment) { opacity: 1; }
  .is-live .edges, .is-live .node i { opacity: 0; }
  .hud { position: absolute; inset: var(--s-4) var(--gutter); color: var(--c-muted); font-size: 10px; font-variant-numeric: tabular-nums; }
  :global(html[data-tier='C']) .hud { display: none; }
  .br { position: absolute; width: 14px; height: 14px; border: 0 solid var(--c-muted); }
  .tl { top: 0; left: 0; border-width: 1px 0 0 1px; }
  .tr { top: 0; right: 0; border-width: 1px 1px 0 0; }
  .bl { bottom: 0; left: 0; border-width: 0 0 1px 1px; }
  .brr { bottom: 0; right: 0; border-width: 0 1px 1px 0; }
  .hud-prompt { position: absolute; top: 22px; left: 22px; }
  .hud-tc { position: absolute; top: 22px; right: 22px; }
  .hud-xy { position: absolute; top: 38px; right: 22px; white-space: pre; }
  :global(html:not([data-fx='armed'])) .hud-xy { display: none; }
  @media (pointer: coarse) { .hud-xy { display: none; } }
  .depth-chip { position: absolute; right: var(--gutter); bottom: var(--s-5); z-index: var(--z-content); background: transparent; color: var(--c-text); border: 1px solid var(--c-rule); border-radius: var(--r-1); padding: var(--s-2) var(--s-3); font-size: 12px; cursor: pointer; }
  .depth-chip:hover { border-color: var(--c-system); color: var(--c-system); }
  .depth-chip[hidden] { display: none; }
  @media (max-width: 720px) { .node { font-size: 10px; } }
</style>
