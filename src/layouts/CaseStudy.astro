---
import Base from './Base.astro';
import ScrollStory from '../islands/ScrollStory.astro';
import { getEntries } from 'astro:content';
import { hashLabel } from '../engine/transitions/hash';

interface Props { entry: any }
const { entry } = Astro.props;
const d = entry.data;
const claims = d.claimIds.length ? await getEntries(d.claimIds.map((id: string) => ({ collection: 'claims', id }))) : [];
---
<Base title={d.title} description={d.thesis}>
  <article class="case" data-signature={d.signature}>
    <header class="wrap case-head">
      <p class="mono muted" data-scroll-depth="0.5">{d.category}</p>
      <h1 class="display" data-fx="decrypt" data-vt={`title-${entry.id}`} data-sig-title>{d.title}</h1>
      <p class="h2 thesis" data-fx="redact">{d.thesis}</p>
      {d.sampleHash && <p class="mono muted" data-sig-hash-target>sample sha-256 {hashLabel(d.sampleHash)}</p>}
    </header>

    <ScrollStory id={entry.id} pipeline={d.pipeline} story={d.story} claims={claims}>
      <slot />
    </ScrollStory>

    <p class="wrap mono"><a href="/work/">Back to all work</a></p>
  </article>
</Base>

<style>
  /* E1: the header hugs the left edge and leaves the right empty; nothing is centred. */
  .case-head { width: 60%; max-width: none; margin-inline: 0; padding-block: var(--s-9) var(--s-7); display: grid; gap: var(--s-4); }
  @media (max-width: 720px) { .case-head { width: 100%; } }
  .thesis { max-width: 22ch; color: var(--c-muted); }
</style>
