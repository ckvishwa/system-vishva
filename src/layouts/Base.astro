---
import '@fontsource-variable/inter-tight';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
// Preload the two latin faces the page really uses, so the swap lands before first paint (no reflow, CLS).
import interLatin from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';
import monoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/ui/Nav.astro';
import StatusBar from '../components/ui/StatusBar.astro';
import Transitions from '../islands/Transitions.astro';
import Atmosphere from '../islands/Atmosphere.astro';
import Terminal from '../islands/Terminal.astro';
import EvidenceDrawer from '../islands/EvidenceDrawer.astro';

interface Props { title: string; description?: string; motion?: boolean }
const { title, description = 'AI systems engineering with security and reliability as first-class constraints.', motion = true } = Astro.props;
// Canonical and og:url exist only when the build knows the public origin (SITE_URL or the Vercel production URL).
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const fullTitle = title === 'Home' ? 'Vishva Teja Chikoti — AI systems, security, reliability' : `${title} — Vishva Teja Chikoti`;
---
<!doctype html>
<html lang="en" data-tier="C">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <!-- Allowed hex exception: meta tags cannot read CSS variables. Keep equal to --c-bg in src/styles/tokens.css. -->
    <meta name="theme-color" content="#050505" />
    <link rel="preload" as="font" type="font/woff2" href={interLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={monoLatin} crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {Astro.site && <link rel="sitemap" href="/sitemap-index.xml" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <!-- ARD §4: tier decided BEFORE first paint. Keep in sync with src/engine/tier.ts (decideTier). -->
    <script is:inline>
      (() => {
        const m = (q) => matchMedia(q).matches;
        const n = navigator;
        let gl = false;
        try { gl = !!document.createElement('canvas').getContext('webgl2'); } catch (e) {}
        const cores = n.hardwareConcurrency || 4, mem = n.deviceMemory ?? null;
        const plain = location.pathname.startsWith('/plain');
        let t = 'B';
        if (plain || m('(prefers-reduced-motion: reduce)') || (n.connection && n.connection.saveData) || !gl) t = 'C';
        else if (cores <= 4 || (mem !== null && mem <= 2)) t = 'C';
        else if (m('(pointer: coarse)')) t = 'B';
        else if (cores >= 8 && (mem === null || mem >= 8)) t = 'A';
        document.documentElement.dataset.tier = t;
        // ADR-0012: atmosphere effects that can hide content (redaction bars) are armed only for tiers A/B,
        // and disarmed if the effects script has not reported ready within 4 s.
        const root = document.documentElement;
        if (t !== 'C') {
          root.dataset.fxMode = 'armed';
          setTimeout(() => { if (!root.dataset.fxReady) root.dataset.fxMode = 'failed'; }, 4000);
        }
        // ClientRouter swaps <html> attributes with the incoming page's (default "C"); carry the decided tier across.
        document.addEventListener('astro:before-swap', (e) => {
          const next = e.newDocument.documentElement;
          next.dataset.tier = t;
          if (root.dataset.fxMode) next.dataset.fxMode = root.dataset.fxMode;
          if (root.dataset.fxReady) next.dataset.fxReady = root.dataset.fxReady;
        });
      })();
    </script>
    {motion && <ClientRouter fallback="swap" />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main"><slot /></main>
    <StatusBar />
    <Transitions />
    <Atmosphere />
    <Terminal />
    <EvidenceDrawer />
  </body>
</html>
