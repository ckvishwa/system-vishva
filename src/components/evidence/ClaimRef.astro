---
// ARD §7 idea 2 — a metric that can show its source. Phase 2 turns this into the evidence drawer.
interface Props { claim: { id: string; data: { label: string; display: string; value?: number; evidence: string | null; evidenceNote?: string } } }
const { claim } = Astro.props;
const { label, display, evidence } = claim.data;
const value = (claim.data as { value?: number }).value;
---
<figure class="metric" id={`claim-${claim.id}`}>
  <figcaption class="mono muted">{label}</figcaption>
  {evidence
    ? <a class="value redact" href={evidence} rel="noopener" target="_blank" title="Open evidence" data-count data-value={value}>{display}</a>
    : <span class="value redact unverified" title="Evidence pending" data-count data-value={value}>{display}</span>}
</figure>
<style>
  .metric { padding: var(--s-5) var(--s-4) var(--s-5) 0; border-bottom: 1px solid var(--c-rule); display: grid; gap: var(--s-2); }
  .value { display: inline-block; justify-self: start; font-size: var(--t-xl); font-weight: 650; letter-spacing: -0.02em; text-decoration: underline dotted var(--c-muted); text-underline-offset: 6px; }
  .unverified { text-decoration: none; }
</style>
