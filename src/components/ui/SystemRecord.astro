---
// Horizontal project record (plan 1 §5). Hover/focus exposes the pipeline underneath.
interface Props { index: number; slug: string; title: string; category: string; pipeline: string[]; metrics: string[] }
const { index, slug, title, category, pipeline, metrics } = Astro.props;
---
<a class="record" href={`/work/${slug}/`} data-cursor="open">
  <span class="idx mono muted">{String(index).padStart(2, '0')}</span>
  <span class="title h1" transition:name={`title-${slug}`}>{title}</span>
  <span class="cat">{category}</span>
  <span class="metrics mono">{metrics.join('   ')}</span>
  <ol class="pipe mono" aria-label={`${title} pipeline`}>
    {pipeline.map((p) => <li>{p}</li>)}
  </ol>
</a>
<style>
  .record { display: grid; grid-template-columns: 3ch 1fr auto; gap: var(--s-2) var(--s-5); align-items: baseline; padding-block: var(--s-6); border-top: 1px solid var(--c-rule); }
  .idx { grid-row: span 2; }
  .cat { color: var(--c-muted); grid-column: 2; }
  .metrics { grid-column: 3; grid-row: 1; text-align: right; color: var(--c-system); }
  .pipe { grid-column: 2 / -1; display: flex; flex-wrap: wrap; list-style: none; gap: 0; max-height: 0; overflow: hidden; opacity: 0; transition: max-height var(--d-3) var(--e-out), opacity var(--d-2); }
  .pipe li + li::before { content: '→'; padding-inline: var(--s-2); color: var(--c-muted); }
  .record:hover .pipe, .record:focus-visible .pipe { max-height: 4em; opacity: 1; padding-top: var(--s-3); }
  .record:hover .title { color: var(--c-system); }
  @media (max-width: 720px) { .record { grid-template-columns: 3ch 1fr; } .metrics { grid-column: 2; grid-row: auto; text-align: left; } .pipe { max-height: none; opacity: 1; } }
</style>
