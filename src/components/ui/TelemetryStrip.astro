---
// Homepage telemetry strip (Phase 1.5): one row of Cells straight from build.json, one link to /status.
// Cells whose data is missing are left out, never faked. No animation beyond the shared count-up.
import Cell from './Cell.astro';
import build from '../../generated/build.json';
const checks = build.gates ?? [];
const passing = checks.filter((g: any) => g.status === 'pass').length;
---
<a class="strip" href="/status/" aria-label="System status: open the full status page" data-strip>
  <div class="cells">
    <Cell label="Commit" value={build.commit} />
    <Cell label="Gate" value={`${passing}/${checks.length} checks`} status={build.gate === 'pass' ? 'pass' : 'block'} chip={build.gate === 'pass' ? 'PASS' : 'BLOCK'} />
    <Cell label="Pages built" value={String(build.pages)} count={build.pages} />
    {build.tests && <Cell label="Tests passing" value={`${build.tests.passed}/${build.tests.total}`} count={build.tests.passed} />}
    {build.js && <Cell label="JS pre-LCP, gz" value={`${build.js.preLcpKb} kB`} />}
  </div>
</a>
<script>
  import { onceVisible } from '../../engine/input/visibility';
  import { countUp } from '../../engine/motion/count';
  // The final text is already in the HTML; this only plays the existing count-up once, when the strip is seen.
  const run = () => {
    const strip = document.querySelector<HTMLElement>('[data-strip]');
    if (strip) onceVisible(strip, () => strip.querySelectorAll<HTMLElement>('[data-count]').forEach(countUp));
  };
  document.addEventListener('astro:page-load', run);
</script>
