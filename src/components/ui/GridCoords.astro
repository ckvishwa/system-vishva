---
// ADR-0013 T4: structure made visible. Tiny mono column indices along the top edge, counting the cells of the
// 48px grid drawn behind the page (.grid-bg), so each number sits on a real grid line: 00 04 08 12 ...
// Decorative and static. Positions are in components.css (every 4th cell = 192px). Put it inside a positioned
// element whose grid starts at its left edge.
const marks = Array.from({ length: 8 }, (_, i) => i * 4);
---
<div class="coords mono" aria-hidden="true">
  {marks.map((n) => <span>{String(n).padStart(2, '0')}</span>)}
</div>
